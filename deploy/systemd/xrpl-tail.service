# xrpl-tail.service -- live follow of new validated ledgers into MongoDB.
# TEMPLATE, NOT TESTED ON A REAL HOST (only reviewed against the systemd man pages).
#
# Installed by install.sh (node / server setup), which replaces the
# placeholders @REPO_DIR@ (absolute repo path) and @USER@ (the non-root user that owns the
# repo) and writes /etc/systemd/system/xrpl-tail.service (not enabled). Then:
#   sudo systemctl enable --now xrpl-tail
# The repo path must not contain % $ " \ or newlines (systemd specifier/quoting rules).
#
# Stop gracefully: `sudo systemctl stop xrpl-tail` (SIGTERM), or a line `tail=0`
# (or `current_process=0`) in process_status.txt in the repo -- tail then exits 0 and,
# because of Restart=on-failure, stays stopped until started again.
# Logs: journalctl -u xrpl-tail -f
#
# Exit codes: 0 ok/stopped · 1 ledgers failed/stopped early · 2 config/args ·
# 3 node lacks part of range · 4 node/Mongo unreachable · 5 another instance holds the
# lock · 6 internal error. 2, 3 and 5 are not restarted (a restart cannot fix them).

[Unit]
Description=XRPL ingest: live tail into MongoDB
Wants=network-online.target
After=network-online.target mongod.service xrpld.service

[Service]
User=@USER@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUTF8=1 PYTHONUNBUFFERED=1 "XRPL_INGEST_HOME=@REPO_DIR@"
ExecStart="@REPO_DIR@/.venv/bin/python" -m xrpl_ingest tail
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3 5
# SIGTERM = graceful stop (in-flight work finishes); SIGKILL after TimeoutStopSec.
TimeoutStopSec=300
KillMode=control-group

[Install]
WantedBy=multi-user.target
