# Copy to .env (never commit .env: it holds credentials)
MONGO_URI=mongodb://localhost:27017
# Optional: read the URI from this file instead (keeps the password out of .env; chmod 600 it).
# MONGO_URI_FILE=/etc/xrpl-ingest/mongo_uri
DB_NAME=xrpl_data_collection
# Optional MongoDB client timeouts (milliseconds)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=120000

# Your own xrpld node. Check the ws port in your xrpld.cfg (admin-local ws is usually 6006).
# Comma-separated; first is preferred, others are failover. Do NOT list testnet servers.
SERVERS=ws://127.0.0.1:6006
# 0 = mainnet. Connection is rejected if the server reports another network_id. Use "none" to disable.
EXPECTED_NETWORK_ID=0

# Collection names (defaults match the legacy .env)
LEDGER_COLLECTION=block_number
TX_COLLECTION=transactions
META_MEMOS_COLLECTION=internal_data
FAILED_TX_COLLECTION=failed_transactions
METADATA_COLLECTION=last_processed_block_no

# Tuning
MAX_RETRIES=5
REQUEST_TIMEOUT=30
RECONNECT_DELAY_BASE=1
BACKOFF_MAX=30
POLLING_INTERVAL_SECONDS=2
NUM_PROCESSES=4
CONCURRENCY=16
CHUNK_SIZE=1000
MAX_MESSAGE_MB=64
LOG_LEVEL=INFO
# Minimum free disk space in GB (0 = check off)
# MIN_FREE_GB=0

# Logging: empty LOG_FILE = log to stderr only; otherwise a rotating log file.
# LOG_MAX_MB = rotate at this size; LOG_BACKUPS = rotated files kept.
# LOG_FILE=logs/xrpl_ingest.log
# LOG_MAX_MB=100
# LOG_BACKUPS=10

# Range used by `backfill` when neither --start nor --end is given (see backfill_range.txt.example)
# BACKFILL_RANGE_FILE=backfill_range.txt

# Stop switch: a line "current_process=0" stops backfill/tail/retry-failed gracefully;
# "tail=0", "backfill=0" or "retry-failed=0" stops only that command (first matching line wins)
PROCESS_STATUS_FILE=process_status.txt

# Relative paths above (stop file, range file, log file, lock files) resolve against the base dir.
# These two locate .env itself, so set them in the process environment (service unit, shell), not here:
#   XRPL_INGEST_HOME=/path/to/base   base dir; default: dir of the loaded .env, else the current dir
#   ENV_FILE=/path/to/.env           explicit .env path instead of <base>/.env
